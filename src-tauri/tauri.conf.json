{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KillCam",
  "version": "0.1.9",
  "identifier": "com.jkeroro.killcam",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KillCam",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "backgroundColor": "#0b0b0b",
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3Mzk4NEExMzJDNTExMDkKUldRSkVjVXlvWVE1SjBTdHlacURPY2JDUVphcUJqWUlseVE1NUpQREJibFBBeGF4UDB3cGV5RVEK",
      "endpoints": [
        "https://github.com/Jkeroromk/killcam/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
